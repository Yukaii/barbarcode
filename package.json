{
  "name": "barbarcode-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "dev": "pnpm --filter barbarcode run dev",
    "dev:web": "pnpm --filter @barbarcode/web run dev",
    "dev:relay": "pnpm --filter @barbarcode/relay run dev",
    "deploy:relay": "pnpm --filter @barbarcode/web run build && pnpm --filter @barbarcode/relay run deploy",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
