{
  "name": "barbarcode",
  "version": "0.2.1",
  "description": "Turn your phone into a barcode scanner that types into your computer.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "barbarcode": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yukaii/barbarcode.git",
    "directory": "packages/cli"
  },
  "homepage": "https://barbarcode.yukai.dev",
  "keywords": [
    "barcode",
    "scanner",
    "qr",
    "keyboard",
    "wedge",
    "cli"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown && node scripts/copy-web.mjs",
    "start": "node dist/cli.mjs",
    "typecheck": "tsc -p .",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "build:bin": "node scripts/build-binaries.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "uqr": "^0.1.3",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@barbarcode/protocol": "workspace:*",
    "@barbarcode/web": "workspace:*",
    "@types/ws": "^8.18.2",
    "tsdown": "^0.23.7"
  }
}
